            </effectNode>
            <effectNode effectClass="CutterMotionPathEffect" effectType="CUTTER_THRESHING" linkNode="effectNodeThreshing">
                <motionPathEffect textureFilename="$data/vehicles/geringhoff/northStar1230FB/threshingArray.dds" numRows="12" rowLength="10" verticalOffset="0" minFade="0.15" startDelay="0.2" stopDelay="0.6"/>
            </effectNode>
            <effectNode effectClass="ParticleEffect" effectNode="smokeEmitter" particleType="SMOKE" materialType="smokeParticle" emitCountScale="0.1" worldSpace="false" useCuttingWidth="false"/>
        </effect>

        <animationNodes>
            <animationNode node="drumLeft"   rotSpeed="900" rotAxis="1" turnOnFadeTime="4" turnOffFadeTime="7"/>
            <animationNode node="drumMiddle" rotSpeed="900" rotAxis="1" turnOnFadeTime="4" turnOffFadeTime="7"/>
            <animationNode node="drumRight"  rotSpeed="900" rotAxis="1" turnOnFadeTime="4" turnOffFadeTime="7"/>

            <animationNode node="rollLeft"  rotSpeed="1300"  rotAxis="3" turnOnFadeTime="3" turnOffFadeTime="5"/>
            <animationNode node="rollRight" rotSpeed="-1300" rotAxis="3" turnOnFadeTime="3" turnOffFadeTime="5"/>

            <animationNode node="cutterRoll01" rotSpeed="800"  rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
