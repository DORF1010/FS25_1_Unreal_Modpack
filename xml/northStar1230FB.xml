            <animationNode node="cutterRoll23" rotSpeed="800"  rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
            <animationNode node="cutterRoll24" rotSpeed="-800" rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>

            <animationNode class="ScrollingAnimation" node="chainsLeft"  scrollSpeed="-3" scrollLength="1" shaderParameterName="offsetUV" shaderParameterComponent="2" turnOnFadeTime="2" turnOffFadeTime="4"/>
            <animationNode class="ScrollingAnimation" node="chainsMiddle"  scrollSpeed="-3" scrollLength="1" shaderParameterName="offsetUV" shaderParameterComponent="2" turnOnFadeTime="2" turnOffFadeTime="4"/>
            <animationNode class="ScrollingAnimation" node="chainsRight"  scrollSpeed="-3" scrollLength="1" shaderParameterName="offsetUV" shaderParameterComponent="2" turnOnFadeTime="2" turnOffFadeTime="4"/>
        </animationNodes>

        <automaticTilt raycastNode1="heightNode01" raycastNode2="heightNode03"/>
        <sounds>
            <cut template="cropCuttingCorn" volumeScale="3.0"/>
        </sounds>
    </cutter>

    <turnOnVehicle turnedOnByAttacherVehicle="true">
        <sounds>
            <start template="maizeHeaderStart" pitchScale="0.8" volumeScale="0.3"/>
            <work  template="maizeHeaderLoop"  pitchScale="0.8" volumeScale="0.3"/>
            <stop  template="maizeHeaderStop"  pitchScale="0.8" volumeScale="0.3"/>
        </sounds>
    </turnOnVehicle>

    <dynamicMount forceLimitScale="1"/>

    <ai>
        <areaMarkers leftNode="workAreaStart" rightNode="workAreaWidth" backNode="workAreaHeight"/>
        <collisionTrigger useSize="true" width="9.4" height="1.6"/>
        <agentAttachment useSize="true"/>
    </ai>

    <foliageBending>
        <bendingNode minX="-2.55" maxX="2.55" minZ="-1.0" maxZ="0.9" yOffset="0.2"/>
        <bendingNode minX="0.22" maxX="2.35" minZ="-0.2" maxZ="1.93" yOffset="-0.38" node="leftArm"/>
        <bendingNode minX="-2.35" maxX="-0.22" minZ="-0.2" maxZ="1.93" yOffset="-0.38" node="rightArm"/>
    </foliageBending>

