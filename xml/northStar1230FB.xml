            <animationNode node="cutterRoll10" rotSpeed="-800" rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
            <animationNode node="cutterRoll11" rotSpeed="800"  rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
