            <animationNode node="cutterRoll19" rotSpeed="800"  rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
            <animationNode node="cutterRoll20" rotSpeed="-800" rotAxis="3" turnOnFadeTime="2" turnOffFadeTime="4"/>
