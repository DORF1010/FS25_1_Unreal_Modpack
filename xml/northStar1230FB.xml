            <combination xmlFilename="$data/vehicles/johnDeere/seriesX9/seriesX9.xml"/>
            <combination xmlFilename="$data/vehicles/caseIH/af11/af11.xml"/>
        </specs>
        <functions>
            <function>$l10n_function_cutter</function>
        </functions>
        <image>$data/vehicles/geringhoff/northStar1230FB/store_northStar1230FB.png</image>
        <price>100000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>GERINGHOFF</brand>
        <category>cornHeaders</category>
        <shopTranslationOffset>0 0 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <shopHeight>4</shopHeight>
        <vertexBufferMemoryUsage>2922752</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>1234688</indexBufferMemoryUsage>
        <textureMemoryUsage>720896</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_cutter</typeDesc>
        <filename>$data/vehicles/geringhoff/northStar1230FB/northStar1230FB.i3d</filename>
        <size width="4.9" length="3.2" height="2.1" lengthOffset="0.2"/>
        <speedLimit value="50"/>
        <components>
            <component centerOfMass="0 0.2 0" solverIterationCount="10" mass="4500"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="COMBINE_HEADER"/>
        <mapHotspot type="CUTTER"/>
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" jointType="cutter">
                <heightNode node="heightNode01"/>
                <heightNode node="heightNode02"/>
                <heightNode node="heightNode03"/>
                <distanceToGround lower="0.1" upper="1.2"/>
                <objectChange node="claasConnector" visibilityActive="false" visibilityInactive="true"/>
            </inputAttacherJoint>
        </inputAttacherJoints>
        <support animationName="moveSupport"/>
    </attachable>

    <connectionHoses>
        <hose inputAttacherJointIndices="1" type="electric" node="electric_node" socket="electric" length="1.4" diameter="0.018" straighteningFactor="1.5"/>
        <customTarget node="claasConnectorNode" type="claasMultiCoupler" inputAttacherJointIndices="1"/>
    </connectionHoses>

    <powerTakeOffs>
        <input inputAttacherJointIndices="1" inputNode="ptoInputLeft"  aboveAttacher="true" ptoName="LEFT_PTO"/>
        <input inputAttacherJointIndices="1" inputNode="ptoInputRight" aboveAttacher="true" ptoName="RIGHT_PTO"/>
        <local startNode="ptoLeft_02"  endNode="ptoLeft_03"  filename="$data/shared/assets/powerTakeOffs/walterscheidW_SC25.xml"/>
        <local startNode="ptoRight_02" endNode="ptoRight_03" filename="$data/shared/assets/powerTakeOffs/walterscheidW_SC25.xml"/>
    </powerTakeOffs>

    <powerConsumer ptoRpm="250" neededMaxPtoPower="50"/>

    <groundReferenceNodes>
        <groundReferenceNode node="groundReferenceNode" threshold="0.5"/>
    </groundReferenceNodes>

    <lights>
        <states>
            <state lightTypes="0"/>
        </states>

        <sharedLight linkNode="sideMarker18_left"  filename="$data/shared/assets/lights/lizard/sideMarker18_right.xml" lightTypes="0"/>
        <sharedLight linkNode="sideMarker18_right" filename="$data/shared/assets/lights/lizard/sideMarker18_left.xml"  lightTypes="0"/>
    </lights>

    <animations>
        <animation name="moveSupport">
            <part node="support"    startTime="0" endTime="1.0" startTrans="0 0 -0.07" endTrans="0 0 0" />
            <part node="supportCol" startTime="0" endTime="0.2" startTrans="0 0.07 0"  endTrans="0 0 0" />
        </animation>

        <animation name="folding">
            <part node="leftArm"  startTime="1" endTime="10" startRot="0 0 0" endRot="0 0 178"  tangentType="spline"/>
            <part node="rightArm" startTime="0" endTime="9"  startRot="0 0 0" endRot="0 0 -178" tangentType="spline"/>

            <part node="coneLeftPart"      startTime="0" endTime="1.5" startRot="-5.7 0 0" endRot="0 0 0" />
            <part node="coneLeft"          startTime="1.5" endTime="4" startRot="0 0 0"    endRot="0 0 30" />
            <part node="hydraulicConeLeft" startTime="1.5" endTime="4" startRot="0 0 0"    endRot="-11 0 0" />

            <part node="coneRightPart"      startTime="0" endTime="0.5" startRot="-5.7 0 0" endRot="0 0 0" />
            <part node="coneRight"          startTime="0.5" endTime="4" startRot="0 0 0"    endRot="0 0 -30" />
            <part node="hydraulicConeRight" startTime="0.5" endTime="4" startRot="0 0 0"    endRot="-11 0 0" />

            <sound template="hydraulicOpen02"  startTime="0.01" endTime="9"    direction="-1"    volumeScale="1.7" pitchScale="1.3" fadeIn="0.1" fadeOut="0.1" linkNode="rightArm"/>
            <sound template="hydraulicOpen05"  startTime="1"    endTime="9.99" direction="-1"    volumeScale="1.7" pitchScale="1.3" fadeIn="0.1" fadeOut="0.1" linkNode="leftArm"/>
            <sound template="hydraulicClose01" startTime="0.01" endTime="9"    direction="1"     volumeScale="3"   pitchScale="0.7" fadeIn="0.1" fadeOut="0.1" linkNode="rightArm"/>
            <sound template="hydraulicClose03" startTime="1"    endTime="9.99" direction="1"     volumeScale="3.5" pitchScale="0.9" fadeIn="0.1" fadeOut="0.1" linkNode="leftArm"/>
            <sound template="vibratingImp"     startTime="1.1"  direction="-1" volumeScale="1"   pitchScale="1.2"  linkNode="leftArm"/>
            <sound template="foldStartMed02"   startTime="1.1"  direction="-1" volumeScale="3"   pitchScale="0.7"  linkNode="leftArm"/>
            <sound template="vibratingImp"     startTime="0.01" direction="-1" volumeScale="1"   pitchScale="1.0"  linkNode="rightArm"/>
            <sound template="metalImpHigh01"   startTime="0.01" direction="-1" volumeScale="0.7" pitchScale="0.8"  linkNode="rightArm"/>
            <sound template="clackVar6"        startTime="9"    direction="1"  volumeScale="1.7" pitchScale="0.7"  linkNode="rightArm"/>
            <sound template="cylinderPunch"    startTime="9"    direction="1"  volumeScale="0.4" pitchScale="1.5"  linkNode="rightArm"/>
            <sound template="sheetImp02"       startTime="9"    direction="1"  volumeScale="2.5" pitchScale="1.5"  linkNode="rightArm"/>
            <sound template="vibratingImp"     startTime="9.99" direction="1"  volumeScale="1"   pitchScale="1.3"  linkNode="leftArm"/>
            <sound template="cylinderPunch"    startTime="9.99" direction="1"  volumeScale="0.5" pitchScale="1.5"  linkNode="leftArm"/>
            <sound template="metalImpHigh01"   startTime="9.99" direction="1"  volumeScale="0.7" pitchScale="0.8"  linkNode="leftArm"/>
        </animation>
    </animations>

    <cylindered>
        <movingTools>
            <movingTool node="leftArm">
                <dependentPart node="leftArmPart01" />
                <dependentPart node="hydraulicConeLeftPunch" />
            </movingTool>
            <movingTool node="rightArm">
                <dependentPart node="rightArmPart01" />
                <dependentPart node="hydraulicConeRightPunch" />
            </movingTool>
        </movingTools>

        <movingParts>
            <movingPart node="leftArmPart01" localReferencePoint="leftArmPart02" referencePoint="leftArmPart02Ref" referenceFrame="leftArmPart01RefFrame">
                <dependentPart node="leftArmPart02"/>
                <dependentPart node="hydraulicLeft"/>
            </movingPart>
            <movingPart node="leftArmPart02" referencePoint="leftArmPart02Ref" referenceFrame="leftArmPart02RefFrame"/>
            <movingPart node="hydraulicLeft" referencePoint="hydraulicLeftRef" referenceFrame="hydraulicLeftRefFrame">
                <translatingPart node="hydraulicLeftPunch" />
            </movingPart>

            <movingPart node="rightArmPart01" localReferencePoint="rightArmPart02" referencePoint="rightArmPart02Ref" referenceFrame="rightArmPart01RefFrame">
                <dependentPart node="rightArmPart02"/>
                <dependentPart node="hydraulicRight"/>
            </movingPart>
            <movingPart node="rightArmPart02" referencePoint="rightArmPart02Ref" referenceFrame="rightArmPart02RefFrame"/>
            <movingPart node="hydraulicRight" referencePoint="hydraulicRightRef" referenceFrame="hydraulicRightRefFrame">
                <translatingPart node="hydraulicRightPunch" />
            </movingPart>
            <movingPart node="hydraulicConeLeftPunch"  referencePoint="hydraulicConeLeftPunchRef"  referenceFrame="hydraulicConeLeftPunchRef"/>
            <movingPart node="hydraulicConeRightPunch" referencePoint="hydraulicConeRightPunchRef" referenceFrame="hydraulicConeRightPunchRef"/>
        </movingParts>
    </cylindered>

    <workAreas>
        <workArea type="cutter" functionName="processCutterArea" >
            <area startNode="workAreaStart" widthNode="workAreaWidth" heightNode="workAreaHeight" />
            <groundReferenceNode index="1" />
            <chopperArea index="2" />
            <testAreas autoGenerate="true" zOffset="0.5" xOffset="0" length="0.6" numAreas="12" areaWidthScale="0.25"/>
        </workArea>
        <workArea type="auxiliary" >
            <area startNode="workAreaStartStraw" widthNode="workAreaWidthStraw" heightNode="workAreaHeightStraw" />
        </workArea>
    </workAreas>

    <foldable>
        <foldingConfigurations>
            <foldingConfiguration>
                <foldingParts startMoveDirection="1" turnOnFoldMaxLimit="0.1" turnOnFoldMinLimit="0" >
                    <foldingPart animationName="folding" speedScale="1.5" />
                </foldingParts>
            </foldingConfiguration>
        </foldingConfigurations>
    </foldable>

    <cutter fruitTypes="MAIZE SUNFLOWER SUGARCANE POPLAR" strawRatio="0.1" fruitTypeConverter="forageHarvester">
        <effect>
            <effectNode effectClass="CutterMotionPathEffect" effectType="CUTTER" linkNode="effectNodePlant">
                <motionPathEffect textureFilename="$data/vehicles/geringhoff/northStar1230FB/plantArray.dds" numRows="12" rowLength="8" minFade="0.19" visibilityY="50 0"/>
            </effectNode>
            <effectNode effectClass="CutterMotionPathEffect" effectType="CUTTER_FRUITS" linkNode="effectNodeFruit">
