    <storeData>
        <name>NorthStar 1230 FB</name>
        <specs>
            <workingWidth>9</workingWidth>
            <combination xmlFilename="cr11/cr11colorfull.xml"/>
            <combination xmlFilename="extraContent/cr11GoldEdition.xml"/>
            <combination xmlFilename="$data/vehicles/caseIH/axialFlow150/axialFlow150.xml"/>
            <combination xmlFilename="$data/vehicles/johnDeere/seriesS7/seriesS7.xml"/>
