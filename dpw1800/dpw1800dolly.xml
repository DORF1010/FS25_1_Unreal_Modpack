        <designColorConfiguration materialTemplateName="SHARED_SILVERROPE1"/>
        <designColorConfiguration materialTemplateName="FARMTECH_GREY1"/>
        <designColorConfiguration materialTemplateName="FARMTECH_GREEN1"/>
        <designColorConfiguration materialTemplateName="FARMTECH_RED1"/>
        <designColorConfiguration materialTemplateName="FARMTECH_YELLOW1"/>
        <designColorConfiguration materialTemplateName="CASEIH_GREY"/>
        <designColorConfiguration materialTemplateName="RIM_CONFIGURATION_CHROME"/>
