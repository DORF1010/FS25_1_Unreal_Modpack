        <lifetime>6000</lifetime>
        <rotation>0</rotation>
        <brand>FARMTECH</brand>
        <category>misc</category>
        <shopTranslationOffset>0 0.5 0</shopTranslationOffset>
        <shopRotationOffset>0.044 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>777472</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>217088</indexBufferMemoryUsage>
        <textureMemoryUsage>393216</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
