<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="implement" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>3 point Loader Adapter</name>
        <specs>
            <combination filterCategory="frontLoaders"/>
        </specs>
        <functions>
            <function>$l10n_function_dolly</function>
            <function>$l10n_function_frontloader</function>
            <function>$l10n_function_wheelWeightsRecommended</function>
        </functions>
        <rotation>0</rotation>
        <image>3pointLoaderAdapter/store_3pointLoaderAdapter.png</image>
        <price>1000</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>600</lifetime>
        <brand>LIZARD</brand>
        <category>frontLoaderTools misc</category>
        <vertexBufferMemoryUsage>130816</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>52992</indexBufferMemoryUsage>
        <textureMemoryUsage>327680</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_tool</typeDesc>
        <filename>3pointLoaderAdapter/3pointLoaderAdapter.i3d</filename>
        <size width="1.85" length="0.85" height="1.05" lengthOffset="0.02"/>
        <components>
            <component centerOfMass="0 -0.1 0" solverIterationCount="10" mass="500" />
        </components>
        <schemaOverlay attacherJointPosition="0 0.25" name="IMPLEMENT" />
        <mapHotspot type="TOOL" />
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" jointType="implement" allowsLowering="false" topReferenceNode="topReferenceNode" lowerRotLimitScale="0 0 0" upperRotationOffset="-1" lowerRotationOffset="0" needsLowering="false">
              <distanceToGround lower="0" upper="0.55" />
              <bottomArm categories="2" ballType="2" />
			  <objectChange node="triangleVis" visibilityInactive="true" visibilityActive="true"/>
            </inputAttacherJoint>
		</inputAttacherJoints>
    </attachable>

    <frontloaderConfigurations>
        <frontloaderConfiguration name="$l10n_ui_no">
        </frontloaderConfiguration>
        <frontloaderConfiguration name="Quicke" displayBrand="QUICKE">
            <attacherJoint node="attacherJointFrontloaderQuicke" jointType="attachableFrontloader" lowerTransLimit="0 0 0" lowerRotLimit="0 0 0" moveTime="2">
                <schema position="0.75 0" rotation="0" invertX="false" />
            </attacherJoint>
            <objectChange node="quickeFrontloaderConsole" visibilityActive="true" visibilityInactive="false"/>
        </frontloaderConfiguration>
        <frontloaderConfiguration name="Hauer" displayBrand="HAUER">
            <attacherJoint node="attacherJointFrontloaderHauer" jointType="attachableFrontloader" lowerTransLimit="0 0 0" lowerRotLimit="0 0 0" moveTime="2" >
                <schema position="0.75 0" rotation="0" invertX="false" />
            </attacherJoint>
            <objectChange node="hauerFrontloaderConsole" visibilityActive="true" visibilityInactive="false"/>
        </frontloaderConfiguration>
    </frontloaderConfigurations>

    <ai>
        <agentAttachment width="1.8" height="1.0" length="0.8"/>
    </ai>

    <tensionBeltObject>
        <meshNodes>
            <meshNode node="tensionBeltMesh01"/>
        </meshNodes>
    </tensionBeltObject>

    <designConfigurations title="$l10n_configuration_attacherJoint">
		<designConfiguration name="Q4M/XB 150">
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#upper" value="0.55" />
            </xmlOverwrites>
		</designConfiguration>
		<designConfiguration name="Q6M/XB 190">
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#upper" value="0.8" />
            </xmlOverwrites>
		</designConfiguration>
		<designConfiguration name="Q7M/M77/V7">
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).distanceToGround#upper" value="0.775" />
            </xmlOverwrites>
		</designConfiguration>
	</designConfigurations>

    <design2Configurations>
		<design2Configuration name="$l10n_configuration_valueDefault">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 0.087"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 0.099"/>
		</design2Configuration>
		<design2Configuration name="-0.1">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 0"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 0"/>
		</design2Configuration>
		<design2Configuration name="-0.5">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -0.5"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -0.5"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
		<design2Configuration name="-1">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -1"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -1"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
		<design2Configuration name="-1.5">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -1.5"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -1.5"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
		<design2Configuration name="-2">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -2"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -2"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
		<design2Configuration name="-2.25">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -2.25"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -2.25"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
		<design2Configuration name="-2.5">
			<objectChange node="quickeFrontloaderConsole" translationActive="0 0.662 -2.5"/>
			<objectChange node="hauerFrontloaderConsole"  translationActive="0 0.804 -2.5"/>
            <xmlOverwrites>
                <set path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0).objectChange(0)#visibilityActive" value="false" />
                <remove path="vehicle.attachable.inputAttacherJoints.inputAttacherJoint(0)#topReferenceNode"/>
            </xmlOverwrites>
		</design2Configuration>
	</design2Configurations>

    <baseColorConfigurations useDefaultColors="true">
        <material materialSlotName="metalPainted_mat"/>
        <baseColorConfiguration materialTemplateName="LIZARD_RED1"/>
        <baseColorConfiguration materialTemplateName="HAUER_BLACK"/>
        <baseColorConfiguration materialTemplateName="HAUER_GREY1"/>
        <baseColorConfiguration materialTemplateName="HAUER_ORANGE"/>
        <baseColorConfiguration materialTemplateName="QUICKE_BLACK1"/>
        <baseColorConfiguration materialTemplateName="QUICKE_ORANGE1"/>
    </baseColorConfigurations>

    <designColorConfigurations useDefaultColors="true">
        <material materialSlotName="console_metalPainted_mat"/>
        <designColorConfiguration materialTemplateName="LIZARD_RED1"/>
        <designColorConfiguration materialTemplateName="HAUER_BLACK"/>
        <designColorConfiguration materialTemplateName="HAUER_GREY1"/>
        <designColorConfiguration materialTemplateName="HAUER_ORANGE"/>
        <designColorConfiguration materialTemplateName="QUICKE_BLACK1"/>
        <designColorConfiguration materialTemplateName="QUICKE_ORANGE1"/>
    </designColorConfigurations>

    <foliageBending>
        <bendingNode minX="-0.95" maxX="0.95" minZ="-0.45" maxZ="0.4" yOffset="0.1" />
    </foliageBending>

    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2" showOnHud="false"/>
    <washable dirtDuration="90"  workMultiplier="2" fieldMultiplier="2" washDuration="1"/>

    <i3dMappings>
        <i3dMapping id="main_component1" node="0>" />
        <i3dMapping id="attacherJoint" node="0>0" />
        <i3dMapping id="topReferenceNode" node="0>1" />
        <i3dMapping id="tensionBeltMesh01" node="0>2|1" />
        <i3dMapping id="triangleVis" node="0>3|0" />
        <i3dMapping id="quickeFrontloaderConsole" node="0>3|1" />
        <i3dMapping id="attacherJointFrontloaderQuicke" node="0>3|1|0" />
        <i3dMapping id="hauerFrontloaderConsole" node="0>3|2" />
        <i3dMapping id="attacherJointFrontloaderHauer" node="0>3|2|0" />
    </i3dMappings>
</vehicle>
